# 复制为 .deploy.env 并填写（勿提交 .deploy.env）
SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=root
SSH_PASS=your_ssh_password

# 服务器上 git 仓库根目录（Go 与 front 同一仓库）
MALL_APP_DIR=/www/wwwroot/ai-token-mall

# Go：HTTP API（--run_bot=false）与 Bot（--run_bot=true）共用 conf 名，一般 prod / local
MALL_USER_RUN_CONF=prod
MALL_BOT_RUN_CONF=prod
# 仅 API 模式校验端口；需与 conf 里 server.port 一致（如 0.0.0.0:8886 → 8886）
MALL_USER_PORT=8886

# 前端 monorepo 目录（相对 MALL_APP_DIR）
MALL_WEB_ROOT=front/apps
# 构建产物（相对 MALL_APP_DIR），Nginx root 指向此目录
MALL_WEB_DIST=front/apps/web-pc/dist
WEB_BUILD_CMD="corepack enable && pnpm install && pnpm build:pc"

GIT_FETCH_TIMEOUT=120
